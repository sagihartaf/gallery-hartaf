---
import { Image } from 'astro:assets';
import type { Work } from '../lib/works';
import { workAlt, workPath } from '../lib/works';

interface Props {
  work: Work;
  sizes: string;
  priority?: boolean;
  delay?: number;
}

const { work, sizes, priority = false, delay = 0 } = Astro.props;
const label = `${work.data.medium}, ${work.data.size}`;
---

<a class="card reveal" href={workPath(work)} style={`--d: ${delay}`}>
  <span class="media">
    <Image
      src={work.data.image}
      alt={workAlt(work)}
      widths={[480, 720, 960, 1280, 1600]}
      sizes={sizes}
      class="card-img"
      transition:name={`work-${work.id}`}
      priority={priority}
    />
  </span>
  <span class="card-text">
    <span class="card-title">{work.data.title}</span>
    <span class="card-meta">{label}</span>
  </span>
</a>
