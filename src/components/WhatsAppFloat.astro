---
import { whatsappHref } from '../lib/contact';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const href = whatsappHref(title);
---

<a class="wa-float" href={href} target="_blank" rel="noopener noreferrer">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      fill="currentColor"
      d="M12 3.15A8.2 8.2 0 0 0 3.8 11.3c0 1.45.38 2.8 1.05 4L3.7 20.7l5.5-1.44a8.2 8.2 0 0 0 2.8.5 8.2 8.2 0 0 0 0-16.4Zm0 1.5a6.7 6.7 0 0 1 0 13.4c-.9 0-1.9-.2-2.9-.7l-.35-.18-3.25.85.87-3.15-.2-.36a6.6 6.6 0 0 1-1-3.4A6.7 6.7 0 0 1 12 4.65Z"
    />
  </svg>
  <span>WhatsApp</span>
</a>
