---
import Wordmark from './Wordmark.astro';
import { enquireHref } from '../lib/contact';
import { categories, type CategoryId } from '../lib/categories';

interface Props {
  section?: CategoryId | 'about' | 'contact';
}

const { section } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';

const resolved =
  section ??
  (path.startsWith('/paintings')
    ? 'paintings'
    : path.startsWith('/objects')
      ? 'objects'
      : path.startsWith('/furniture')
        ? 'furniture'
        : path.startsWith('/food')
          ? 'food'
          : path.startsWith('/about')
            ? 'about'
            : path.startsWith('/contact')
              ? 'contact'
              : undefined);

const studio = [
  { href: '/about', id: 'about', label: 'About' },
  { href: '/contact', id: 'contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="frame header-bar">
    {isHome ? (
      <h1 class="brand"><Wordmark /></h1>
    ) : (
      <p class="brand"><Wordmark /></p>
    )}
    <nav class="nav" aria-label="Primary">
      <div class="nav-set">
        {categories.map((category) => (
          <a href={category.path} aria-current={resolved === category.id ? 'page' : undefined}>
            {category.label}
          </a>
        ))}
      </div>
      <div class="nav-set nav-set-quiet">
        {studio.map((link) => (
          <a href={link.href} aria-current={resolved === link.id ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </div>
    </nav>
    <a class="enquire" href={enquireHref()}>Enquire</a>
  </div>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    document.documentElement.style.setProperty('--header', header.offsetHeight + 'px');
  })();
</script>
