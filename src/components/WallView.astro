---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  title: string;
  widthCm: number;
  heightCm: number;
}

const { src, title, widthCm, heightCm } = Astro.props;

const sceneW = 560;
const sceneH = 320;
const floor = 278;
const eye = 158;
const margin = 18;
let top = floor - eye - heightCm / 2;
const minTop = margin;
const maxTop = floor - 12 - heightCm;
if (maxTop >= minTop) top = Math.min(Math.max(top, minTop), maxTop);
else top = minTop;
const left = Math.max(margin, (sceneW - widthCm) / 2);
---

<div
  class="room"
  style={`--pl:${left};--pt:${top};--pw:${widthCm};--ph:${heightCm}`}
>
  <svg class="room-svg" viewBox="0 0 560 320" role="img" aria-label={`${title} at scale on a gallery wall`}>
    <defs>
      <linearGradient id="wall-light" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f4efe8" />
        <stop offset="0.72" stop-color="#e7dfd4" />
        <stop offset="1" stop-color="#ddd4c8" />
      </linearGradient>
      <filter id="plaster" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="4" />
        <feColorMatrix type="matrix" values="0 0 0 0 0.45  0 0 0 0 0.4  0 0 0 0 0.34  0 0 0 0.045 0" />
      </filter>
    </defs>
    <rect width="560" height="320" fill="url(#wall-light)" />
    <rect width="560" height="320" filter="url(#plaster)" />
    <rect y="278" width="560" height="42" fill="#d9cfc2" />
    <rect y="270" width="560" height="8" fill="#c9bbaa" />
    <ellipse cx="128" cy="276" rx="96" ry="4.5" fill="#1c1916" opacity="0.06" />
    <g>
      <rect x="40" y="206" width="176" height="30" rx="6" fill="#ddd2c4" />
      <rect x="28" y="232" width="200" height="22" rx="4" fill="#cfc3b3" />
      <rect x="42" y="252" width="5" height="24" fill="#8c7c6b" />
      <rect x="209" y="252" width="5" height="24" fill="#8c7c6b" />
    </g>
    <ellipse cx="500" cy="276" rx="16" ry="3.5" fill="#1c1916" opacity="0.07" />
    <g fill="#2a241f" opacity="0.78" transform="translate(482 108)">
      <ellipse cx="16" cy="11" rx="6.4" ry="8" />
      <path d="M7.5 22.5c1.4 7 3.2 10 8.5 10s7.1-3 8.5-10c5 3.2 8 11 7 24-1.4 9-4.6 16-7 18H10c-2.4-2-5.6-9-7-18-1-13 2-20.8 7-24z" />
      <path d="M11 72h10.2l1.6 86h-4.4l-.9-52-.7 52H9.6z" />
      <path d="M5.2 40c-3 8-3.4 16-1.6 24 1.6-7 3-14 4.2-20 .5-2.2.2-3.4-.6-4z" />
      <path d="M26.8 40c3 8 3.4 16 1.6 24-1.6-7-3-14-4.2-20-.5-2.2-.2-3.4.6-4z" />
    </g>
  </svg>
  <Image
    src={src}
    alt=""
    widths={[480, 800, 1200]}
    sizes="(min-width: 900px) 28vw, 46vw"
    class="room-art"
  />
</div>
