---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-600-italic.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
}

const { title, description, ogImage } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

let ogSrc: string | undefined;
if (ogImage && Astro.site) {
  const rendered = await getImage({ src: ogImage, width: 1200, format: 'jpg' });
  ogSrc = new URL(rendered.src, Astro.site).href;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
    <meta name="theme-color" content="#f6f3ee" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gallery Hartaf" />
    {ogSrc && <meta property="og:image" content={ogSrc} />}
    {ogSrc && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script>
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      let revealObserver: IntersectionObserver | undefined;

      function armReveals() {
        revealObserver?.disconnect();
        const items = document.querySelectorAll('.reveal');
        if (reduce) {
          items.forEach((item) => item.classList.add('is-shown'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-shown');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.16, rootMargin: '0px 0px -6% 0px' },
        );
        revealObserver = observer;
        const view = window.innerHeight * 0.92;
        items.forEach((item) => {
          item.classList.remove('arm', 'is-shown');
          if (item.getBoundingClientRect().top < view) {
            item.classList.add('is-shown');
            return;
          }
          item.classList.add('arm');
          observer.observe(item);
        });
      }

      function playHero() {
        const hero = document.querySelector('[data-hero]');
        if (!hero || reduce) return;
        hero.classList.add('is-entering');
        requestAnimationFrame(() => {
          requestAnimationFrame(() => hero.classList.add('is-settled'));
        });
      }

      function bindParallax() {
        if (root.dataset.parallax || reduce || !finePointer) return;
        root.dataset.parallax = 'on';
        let frame = 0;
        const update = () => {
          frame = 0;
          const height = window.innerHeight || 1;
          document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((node) => {
            const box = node.getBoundingClientRect();
            const progress = (box.top + box.height / 2 - height / 2) / height;
            const shift = Math.max(-1, Math.min(1, progress)) * -18;
            node.style.transform = `translate3d(0, ${shift.toFixed(2)}px, 0)`;
          });
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!frame) frame = requestAnimationFrame(update);
          },
          { passive: true },
        );
        update();
      }

      if (!root.dataset.walkKeys) {
        root.dataset.walkKeys = 'on';
        const onPage = () => {
          armReveals();
          playHero();
          bindParallax();
        };
        document.addEventListener('astro:page-load', onPage);
        onPage();
        document.addEventListener('keydown', (event) => {
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          const target = event.target;
          if (
            target instanceof HTMLElement &&
            target.closest('input, textarea, select, [contenteditable="true"]')
          ) {
            return;
          }
          const walk = document.querySelector('[data-walk]');
          if (!walk) return;
          const prev = walk.querySelector<HTMLAnchorElement>('[data-prev]');
          const next = walk.querySelector<HTMLAnchorElement>('[data-next]');
          if (event.key === 'ArrowLeft' && prev) {
            event.preventDefault();
            prev.click();
          }
          if (event.key === 'ArrowRight' && next) {
            event.preventDefault();
            next.click();
          }
        });
      }
    </script>
  </body>
</html>
