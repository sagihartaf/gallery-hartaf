---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-600-italic.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import type { CategoryId } from '../lib/categories';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogAlt?: string;
  section?: CategoryId | 'about' | 'contact';
  whatsappTitle?: string;
  jsonLd?: unknown;
}

const { title, description, ogImage = '/og/home.jpg', ogAlt, section, whatsappTitle, jsonLd } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogSrc = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
    <meta name="theme-color" content="#f6f3ee" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gallery Hartaf" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogSrc} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogSrc} />
    {ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {json && <script type="application/ld+json" set:html={json} />}
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header section={section} />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat title={whatsappTitle} />
    <script>
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      let revealObserver: IntersectionObserver | undefined;

      function measureHeader() {
        const header = document.querySelector('.site-header');
        if (!header) return;
        root.style.setProperty('--header', `${header.getBoundingClientRect().height}px`);
      }

      function armReveals() {
        revealObserver?.disconnect();
        const items = document.querySelectorAll('.reveal');
        if (reduce) {
          items.forEach((item) => item.classList.add('is-shown'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-shown');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.16, rootMargin: '0px 0px -6% 0px' },
        );
        revealObserver = observer;
        const view = window.innerHeight * 0.92;
        items.forEach((item) => {
          item.classList.remove('arm', 'is-shown');
          if (item.getBoundingClientRect().top < view) {
            item.classList.add('is-shown');
            return;
          }
          item.classList.add('arm');
          observer.observe(item);
        });
      }

      function bindParallax() {
        if (reduce || !finePointer) return;
        let frame = 0;
        const update = () => {
          frame = 0;
          const height = window.innerHeight || 1;
          document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((node) => {
            const raw = Number(node.dataset.parallax);
            const depth = Number.isFinite(raw) && raw !== 0 ? raw : 1;
            const box = node.getBoundingClientRect();
            const progress = (box.top + box.height / 2 - height / 2) / height;
            const shift = Math.max(-1, Math.min(1, progress)) * -16 * depth;
            node.style.transform = `translate3d(0, ${shift.toFixed(2)}px, 0)`;
          });
        };
        if (!root.dataset.parallaxBound) {
          root.dataset.parallaxBound = 'on';
          window.addEventListener(
            'scroll',
            () => {
              if (!frame) frame = requestAnimationFrame(update);
            },
            { passive: true },
          );
        }
        update();
      }

      if (!root.dataset.walkKeys) {
        root.dataset.walkKeys = 'on';
        const onPage = () => {
          measureHeader();
          armReveals();
          bindParallax();
        };
        document.addEventListener('astro:page-load', onPage);
        window.addEventListener('resize', measureHeader);
        onPage();
        document.addEventListener('keydown', (event) => {
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          const target = event.target;
          if (
            target instanceof HTMLElement &&
            target.closest('input, textarea, select, [contenteditable="true"]')
          ) {
            return;
          }
          const walk = document.querySelector('[data-walk]');
          if (!walk) return;
          const prev = walk.querySelector<HTMLAnchorElement>('[data-prev]');
          const next = walk.querySelector<HTMLAnchorElement>('[data-next]');
          if (event.key === 'ArrowLeft' && prev) {
            event.preventDefault();
            prev.click();
          }
          if (event.key === 'ArrowRight' && next) {
            event.preventDefault();
            next.click();
          }
        });
      }
    </script>
  </body>
</html>
