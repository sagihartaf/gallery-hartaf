---
import { seriesList } from '../../../lib/series';

export function getStaticPaths() {
  return seriesList.map((series) => ({ params: { series: series.id } }));
}

const to = `/paintings/series/${Astro.params.series}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Paintings</title>
    <link rel="canonical" href={to} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
  </head>
  <body>
    <p><a href={to}>Paintings</a></p>
  </body>
</html>
