---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import { getWorks, neighbours, workPath } from '../../lib/works';
import { seriesLabel } from '../../lib/series';
import { contactChannels, gallery } from '../../lib/contact';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { slug: work.id } }));
}

const slug = Astro.params.slug ?? '';
const works = await getWorks();
const work = works.find((entry) => entry.id === slug);
if (!work) {
  throw new Error(`Missing artwork: ${slug}`);
}

const { prev, next } = neighbours(works, work.id);
const channels = contactChannels(work.data.title);
const email = channels.find((channel) => channel.id === 'email');
const others = channels.filter((channel) => channel.id !== 'email');
const description = `${work.data.title}. ${work.data.medium}, ${work.data.size}. A painting by Shmuel Hartaf.`;
---

<Base
  title={`${work.data.title} — Gallery Hartaf`}
  description={description}
  ogImage={work.data.image as ImageMetadata}
>
  <article class="page">
    <div class="work-layout">
      <figure class="work-figure">
        <Image
          src={work.data.image}
          alt={`${work.data.title}, ${work.data.medium}`}
          widths={[640, 960, 1280, 1800, 2200]}
          sizes="(min-width: 900px) 62vw, 92vw"
          transition:name={`work-${work.id}`}
          priority
        />
      </figure>
      <div class="work-meta">
        <h1 class="work-title">{work.data.title}</h1>
        <dl class="specs">
          <div>
            <dt>Medium</dt>
            <dd>{work.data.medium}</dd>
          </div>
          <div>
            <dt>Size</dt>
            <dd>{work.data.size}</dd>
          </div>
          <div>
            <dt>Series</dt>
            <dd>
              <a href={`/works/series/${work.data.series}`}>{seriesLabel(work.data.series)}</a>
            </dd>
          </div>
        </dl>
        {email && <a class="enquire" href={email.href}>Enquire</a>}
        <p class="enquire-note">{gallery.email}</p>
        {others.length > 0 && (
          <ul class="other-channels">
            {others.map((channel) => (
              <li><a href={channel.href}>{channel.label}</a></li>
            ))}
          </ul>
        )}
      </div>
    </div>

    {prev && next && (
      <nav class="walk" data-walk aria-label="Other paintings">
        <a href={workPath(prev)} data-prev>
          <span class="walk-kicker">Previous</span>
          <span class="walk-title">{prev.data.title}</span>
        </a>
        <a href={workPath(next)} data-next>
          <span class="walk-kicker">Next</span>
          <span class="walk-title">{next.data.title}</span>
        </a>
      </nav>
    )}
  </article>
</Base>
