---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import WorkCard from '../components/WorkCard.astro';
import { getByCategory } from '../lib/works';
import { homeJsonLd } from '../lib/seo';

const paintings = await getByCategory('paintings');
const selected = paintings.filter((work) => work.data.featured);
const description =
  'Paintings by Shmuel Hartaf. Oil, acrylic, and mixed media from a studio in southern Israel.';
const jsonLd = Astro.site ? homeJsonLd(Astro.site, description) : undefined;
---

<Base
  title="Gallery Hartaf — Paintings by Shmuel Hartaf"
  description={description}
  ogImage="/og/home.jpg"
  ogAlt="Gallery Hartaf, paintings by Shmuel Hartaf"
  jsonLd={jsonLd}
>
  <HeroSlider works={paintings} />

  <section class="page lede reveal">
    <p>Paintings by Shmuel Hartaf, from a studio in southern Israel.</p>
    <a href="/about">About the artist</a>
  </section>

  {selected.length > 0 && (
    <section class="page section" aria-labelledby="selected-heading">
      <h2 class="section-title reveal" id="selected-heading">Selected works</h2>
      <div class="hang hang-home">
        {selected.map((work, index) => (
          <WorkCard
            work={work}
            sizes="(min-width: 1120px) 46vw, (min-width: 740px) 46vw, 92vw"
            delay={index % 2}
          />
        ))}
      </div>
      <p class="more"><a href="/paintings">All paintings</a></p>
    </section>
  )}
</Base>
