---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { getWorks, workPath } from '../lib/works';
import type { ImageMetadata } from 'astro';

const works = await getWorks();
const heroes = works.filter((work) => work.data.hero);
const hero = heroes[0] ?? works[0];
const selected = works.filter((work) => work.data.featured && work.id !== hero?.id);
const description =
  'Paintings by Shmuel Hartaf. Oil, acrylic, and mixed media from a studio in southern Israel.';
---

<Base title="Gallery Hartaf" description={description} ogImage={hero?.data.image as ImageMetadata | undefined}>
  {hero ? (
    <section class="page hero">
      <a class="hero-link" data-hero href={workPath(hero)}>
        <span class="hero-stage" data-parallax>
          <Image
            src={hero.data.image}
            alt=""
            widths={[640, 960, 1280, 1800, 2400]}
            sizes="(min-width: 900px) 92vw, 94vw"
            class="hero-img"
            transition:name={`work-${hero.id}`}
            priority
          />
        </span>
        <span class="hero-label">
          <span class="hero-title">{hero.data.title}</span>
          <span class="hero-meta">{hero.data.medium}, {hero.data.size}</span>
        </span>
      </a>
    </section>
  ) : (
    <div class="page">
      <p class="empty">No paintings yet.</p>
    </div>
  )}

  <section class="page lede reveal">
    <p>Paintings by Shmuel Hartaf, from a studio in southern Israel.</p>
    <a href="/about">About the artist</a>
  </section>

  {selected.length > 0 && (
    <section class="page section" aria-labelledby="selected-heading">
      <h2 class="section-title reveal" id="selected-heading">Selected works</h2>
      <div class="hang hang-home">
        {selected.map((work, index) => (
          <WorkCard
            work={work}
            sizes="(min-width: 1120px) 46vw, (min-width: 740px) 46vw, 92vw"
            delay={index % 2}
          />
        ))}
      </div>
      <p class="more"><a href="/works">All works</a></p>
    </section>
  )}
</Base>
