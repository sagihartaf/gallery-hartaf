---
import Base from '../../../layouts/Base.astro';
import WorksBrowser from '../../../components/WorksBrowser.astro';
import { seriesList, seriesLabel, isSeries } from '../../../lib/series';

export function getStaticPaths() {
  return seriesList.map((series) => ({ params: { series: series.id } }));
}

const series = Astro.params.series ?? '';
if (!isSeries(series)) {
  throw new Error(`Unknown series: ${series}`);
}

const label = seriesLabel(series);
---

<Base
  title={`${label} — Gallery Hartaf`}
  description={`Paintings by Shmuel Hartaf in ${label}.`}
  section="paintings"
>
  <WorksBrowser active={series} />
</Base>
